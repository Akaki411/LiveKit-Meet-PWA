{
  "name": "livekit-rari",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.0",
  "description": "A Runtime Accelerated Rendering Infrastructure (rari) application",
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "build": "bun node_modules/rari/dist/cli.mjs build",
    "dev": "bun node_modules/rari/dist/cli.mjs dev",
    "start": "bun node_modules/rari/dist/cli.mjs start",
    "deploy:railway": "bun node_modules/rari/dist/cli.mjs deploy railway",
    "deploy:render": "echo \"Push to GitHub and connect to Render to deploy\"",
    "clean": "bun node_modules/rari/dist/cli.mjs clean",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@datadog/browser-logs": "^5.23.3",
