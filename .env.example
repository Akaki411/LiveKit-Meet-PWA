# Docker deploy: copy this file to .env  (cp .env.example .env)
# Native dev:    copy this file to .env.local
# Then set the values below.

# REQUIRED SETTINGS
# #################
# Generate a strong secret, e.g.  openssl rand -hex 32
# The key name (LIVEKIT_API_KEY) is not secret; only the secret must be random.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=change-this-livekit-secret-to-a-long-random-value
# Public URL the BROWSER uses to reach LiveKit. Must be reachable by clients:
#  - local single-machine test: ws://localhost:7880
#  - production: wss://livekit.your-domain (behind a TLS reverse proxy)
LIVEKIT_URL=ws://localhost:7880
# Internal URL the SERVER uses to reach LiveKit.
LIVEKIT_SERVER_URL=http://127.0.0.1:7880
# Secret used to sign auth session cookies (HMAC). Set a long random value.
# Generate one with: openssl rand -hex 32
AUTH_SECRET=

# Redis — used by LiveKit + Egress for coordination/caching and REQUIRED for recording.
# REDIS_ADDRESS=localhost:6379


# OPTIONAL SETTINGS
# #################

# --- Recording ---
# NEXT_PUBLIC_SHOW_SETTINGS_MENU=true
# NEXT_PUBLIC_LK_RECORD_ENDPOINT=/api/record
# Where local recordings are written inside the egress container (mounted to
# ./recordings). Ignored when S3 below is configured.
# RECORD_OUTPUT_DIR=/out
# Store recordings in S3-compatible storage instead of local files (optional):
# S3_KEY_ID=
# S3_KEY_SECRET=
# S3_ENDPOINT=
# S3_BUCKET=
# S3_REGION=

# Optional, to pipe logs to datadog
# NEXT_PUBLIC_DATADOG_CLIENT_TOKEN=client-token
# NEXT_PUBLIC_DATADOG_SITE=datadog-site

